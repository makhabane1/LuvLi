# Luvli ♡ — environment variables for the real AI coach
#
# Copy this file to `.env` and fill in your own key. `.env` must NEVER be
# committed — it is already in .gitignore.
#
#   cp .env.example .env      (macOS / Linux)
#   copy .env.example .env    (Windows)
#
# On Netlify / Vercel you do not use this file at all: set the same names in
# their dashboard (Netlify → Site settings → Environment variables,
# Vercel → Project → Settings → Environment Variables).

# ---- required -------------------------------------------------------------

# Your model provider key. This is the ONLY secret.
# Get one at:  https://platform.openai.com/api-keys
#          or: https://console.anthropic.com/settings/keys
COACH_API_KEY=

# ---- optional -------------------------------------------------------------

# Which provider to call: 'openai' (default) or 'anthropic'.
COACH_PROVIDER=openai

# Override the model. Sensible defaults are used if you leave this blank.
#   OpenAI:    gpt-4o-mini
#   Anthropic: claude-3-5-haiku-latest
COACH_MODEL=

# Lock CORS to your own site so only your pages can call the function.
# Leave blank (or unset) to allow any origin — fine for local development.
# Example: https://luvli.example.com
LUVLI_ALLOWED_ORIGIN=
